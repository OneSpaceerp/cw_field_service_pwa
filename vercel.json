{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://onespace.cw-eg.com/api/:match*"
    },
    {
      "source": "/files/:match*",
      "destination": "https://onespace.cw-eg.com/files/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
